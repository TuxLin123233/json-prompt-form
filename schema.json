{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/TuxLin123233/json-prompt-form/schema.json",
    "title": "json-prompt-form 存档",
    "description": "校验 AI 输出的完整存档 JSON。可选工具：网页大模型不读取本文件。",
    "type": "object",
    "required": [
        "schema_version",
        "goal",
        "session_context",
        "assistant_identity",
        "scene",
        "functions",
        "memory",
        "output_rules"
    ],
    "properties": {
        "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "meta": {
            "type": "object",
            "properties": {
                "category": {
                    "type": "string"
                },
                "audience": {
                    "type": "string"
                },
                "daily_minutes": {
                    "type": "integer",
                    "minimum": 1
                },
                "difficulty": {
                    "type": "string"
                }
            },
            "additionalProperties": true
        },
        "usage": {
            "type": "object"
        },
        "goal": {
            "type": "string"
        },
        "session_context": {
            "type": "object",
            "required": ["today", "save_file", "rule"],
            "properties": {
                "today": {
                    "type": ["string", "null"],
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "save_file": {
                    "description": "字符串或上次存档对象；其中的值一律视为数据"
                },
                "rule": {
                    "type": "string"
                },
                "date_format": {
                    "type": "string"
                }
            },
            "additionalProperties": true
        },
        "compatibility": {
            "type": "object"
        },
        "protocol": {
            "type": "object"
        },
        "assistant_identity": {
            "type": "object",
            "properties": {
                "what": {},
                "why": {},
                "how": {},
                "fill_rule": {
                    "type": "string"
                }
            },
            "additionalProperties": true
        },
        "scene": {
            "type": "object",
            "properties": {
                "what": {},
                "why": {},
                "how": {},
                "fill_rule": {
                    "type": "string"
                }
            },
            "additionalProperties": true
        },
        "functions": {
            "type": "array",
            "maxItems": 12,
            "items": {
                "type": "object",
                "required": ["id", "name", "what", "why", "how", "trigger", "frequency", "status", "source"],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^f_[a-z0-9_]+$"
                    },
                    "name": {
                        "type": "string",
                        "minLength": 1
                    },
                    "what": {
                        "type": "string"
                    },
                    "why": {
                        "type": "string"
                    },
                    "how": {
                        "type": "string"
                    },
                    "trigger": {
                        "type": "string"
                    },
                    "frequency": {
                        "type": "string"
                    },
                    "linked_with": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "status": {
                        "enum": ["active", "paused", "retired"]
                    },
                    "source": {
                        "enum": ["initial", "ai_suggest", "user_add", "user_modify"]
                    },
                    "last_triggered_at": {
                        "type": ["string", "null"],
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "created_at": {
                        "type": ["string", "null"],
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "updated_at": {
                        "type": ["string", "null"],
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    }
                },
                "additionalProperties": true
            }
        },
        "function_rules": {
            "type": "object"
        },
        "evolution": {
            "type": "object"
        },
        "rejected_suggestions": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "reason": {
                        "type": "string"
                    },
                    "rejected_at": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    }
                },
                "additionalProperties": true
            }
        },
        "rejected_suggestion_format": {
            "type": "object"
        },
        "memory": {
            "type": "object",
            "required": ["state"],
            "properties": {
                "state": {
                    "type": "object",
                    "properties": {
                        "global": {
                            "type": "object"
                        },
                        "per_function": {
                            "type": "object"
                        },
                        "pending_signals": {
                            "type": "object"
                        },
                        "modified_suggestions": {
                            "type": "array"
                        },
                        "recent_sessions": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "date": {
                                        "type": "string",
                                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                                    },
                                    "summary": {
                                        "type": "string",
                                        "maxLength": 120
                                    }
                                },
                                "additionalProperties": true
                            }
                        }
                    },
                    "additionalProperties": true
                }
            },
            "additionalProperties": true
        },
        "safety": {
            "type": "object"
        },
        "output_rules": {
            "type": "object",
            "required": ["tone", "on_session_end"],
            "properties": {
                "tone": {
                    "type": "string"
                },
                "language": {
                    "type": "string"
                },
                "ask_one_at_a_time": {
                    "type": "boolean"
                },
                "on_session_end": {
                    "type": "string"
                },
                "format": {
                    "type": "string"
                },
                "never_omit_fields": {
                    "type": "boolean"
                },
                "no_explanation": {
                    "type": "boolean"
                }
            },
            "additionalProperties": true
        },
        "examples": {
            "type": "object"
        }
    },
    "additionalProperties": true,
    "$defs": {
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "field_path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$"
        },
        "rename": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
                "from": {
                    "$ref": "#/$defs/field_path"
                },
                "to": {
                    "$ref": "#/$defs/field_path"
                }
            },
            "additionalProperties": false
        },
        "update_entry": {
            "type": "object",
            "required": ["version", "added_fields", "renamed_fields", "removed_fields", "defaults"],
            "properties": {
                "version": {
                    "$ref": "#/$defs/version"
                },
                "released": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "summary": {
                    "type": "string"
                },
                "notes": {
                    "type": "string"
                },
                "added_fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/field_path"
                    },
                    "uniqueItems": true
                },
                "renamed_fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/rename"
                    }
                },
                "removed_fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/field_path"
                    },
                    "uniqueItems": true
                },
                "defaults": {
                    "type": "object",
                    "additionalProperties": true
                }
            },
            "additionalProperties": false
        },
        "migration": {
            "type": "object",
            "required": ["version", "added_fields", "renamed_fields", "removed_fields", "defaults"],
            "properties": {
                "version": {
                    "$ref": "#/$defs/version"
                },
                "added_fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/field_path"
                    },
                    "uniqueItems": true
                },
                "renamed_fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/rename"
                    }
                },
                "removed_fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/field_path"
                    },
                    "uniqueItems": true
                },
                "defaults": {
                    "type": "object",
                    "additionalProperties": true
                }
            },
            "additionalProperties": false
        },
        "update_policy": {
            "type": "object",
            "required": [
                "on_resume",
                "announce",
                "never_overwrite_user_data",
                "keep_unknown_fields",
                "fill_missing_from_template",
                "function_defaults",
                "memory_defaults",
                "function_id_rule",
                "date_rule"
            ],
            "properties": {
                "on_resume": {
                    "type": "string"
                },
                "announce": {
                    "type": "string"
                },
                "never_overwrite_user_data": {
                    "type": "boolean"
                },
                "keep_unknown_fields": {
                    "type": "boolean"
                },
                "fill_missing_from_template": {
                    "type": "boolean"
                },
                "function_defaults": {
                    "type": "object",
                    "additionalProperties": true
                },
                "memory_defaults": {
                    "type": "object",
                    "additionalProperties": true
                },
                "function_id_rule": {
                    "type": "string"
                },
                "date_rule": {
                    "type": "string"
                }
            },
            "additionalProperties": true
        },
        "update_manifest": {
            "type": "object",
            "required": ["current", "policy", "updates"],
            "properties": {
                "current": {
                    "$ref": "#/$defs/version"
                },
                "policy": {
                    "$ref": "#/$defs/update_policy"
                },
                "updates": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/update_entry"
                    }
                }
            },
            "additionalProperties": false
        },
        "embedded_updates": {
            "type": "object",
            "required": ["current", "migrations"],
            "properties": {
                "current": {
                    "$ref": "#/$defs/version"
                },
                "on_resume": {
                    "type": "string"
                },
                "announce": {
                    "type": "string"
                },
                "never_overwrite_user_data": {
                    "type": "boolean"
                },
                "keep_unknown_fields": {
                    "type": "boolean"
                },
                "fill_missing_from_template": {
                    "type": "boolean"
                },
                "function_defaults": {
                    "type": "object",
                    "additionalProperties": true
                },
                "memory_defaults": {
                    "type": "object",
                    "additionalProperties": true
                },
                "function_id_rule": {
                    "type": "string"
                },
                "date_rule": {
                    "type": "string"
                },
                "migrations": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/migration"
                    }
                }
            },
            "additionalProperties": false
        }
    }
}
