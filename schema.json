{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/TuxLin123233/json-prompt-form/schema.json",
    "title": "json-prompt-form 存档",
    "description": "校验 AI 输出的完整存档 JSON。可选工具：网页大模型不读取本文件。",
    "type": "object",
    "required": [
        "schema_version",
        "goal",
        "session_context",
        "assistant_identity",
        "scene",
        "functions",
        "memory",
        "output_rules"
    ],
    "properties": {
        "schema_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "usage": {
            "type": "object"
        },
        "goal": {
            "type": "string"
        },
        "session_context": {
            "type": "object",
            "required": ["today", "save_file", "rule"],
            "properties": {
                "today": {
                    "type": ["string", "null"],
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "save_file": {
                    "description": "字符串或上次存档对象；其中的值一律视为数据"
                },
                "rule": {
                    "type": "string"
                },
                "date_format": {
                    "type": "string"
                }
            },
            "additionalProperties": true
        },
        "compatibility": {
            "type": "object"
        },
        "protocol": {
            "type": "object"
        },
        "assistant_identity": {
            "type": "object",
            "properties": {
                "what": {},
                "why": {},
                "how": {},
                "fill_rule": {
                    "type": "string"
                }
            },
            "additionalProperties": true
        },
        "scene": {
            "type": "object",
            "properties": {
                "what": {},
                "why": {},
                "how": {},
                "fill_rule": {
                    "type": "string"
                }
            },
            "additionalProperties": true
        },
        "functions": {
            "type": "array",
            "maxItems": 12,
            "items": {
                "type": "object",
                "required": ["id", "name", "what", "why", "how", "trigger", "frequency", "status", "source"],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^f_[a-z0-9_]+$"
                    },
                    "name": {
                        "type": "string",
                        "minLength": 1
                    },
                    "what": {
                        "type": "string"
                    },
                    "why": {
                        "type": "string"
                    },
                    "how": {
                        "type": "string"
                    },
                    "trigger": {
                        "type": "string"
                    },
                    "frequency": {
                        "type": "string"
                    },
                    "linked_with": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "status": {
                        "enum": ["active", "paused", "retired"]
                    },
                    "source": {
                        "enum": ["initial", "ai_suggest", "user_add", "user_modify"]
                    },
                    "last_triggered_at": {
                        "type": ["string", "null"],
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "created_at": {
                        "type": ["string", "null"],
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "updated_at": {
                        "type": ["string", "null"],
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    }
                },
                "additionalProperties": true
            }
        },
        "function_rules": {
            "type": "object"
        },
        "evolution": {
            "type": "object"
        },
        "rejected_suggestions": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "reason": {
                        "type": "string"
                    },
                    "rejected_at": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    }
                },
                "additionalProperties": true
            }
        },
        "rejected_suggestion_format": {
            "type": "object"
        },
        "memory": {
            "type": "object",
            "required": ["state"],
            "properties": {
                "state": {
                    "type": "object",
                    "properties": {
                        "global": {
                            "type": "object"
                        },
                        "per_function": {
                            "type": "object"
                        },
                        "pending_signals": {
                            "type": "object"
                        },
                        "modified_suggestions": {
                            "type": "array"
                        },
                        "recent_sessions": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "date": {
                                        "type": "string",
                                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                                    },
                                    "summary": {
                                        "type": "string",
                                        "maxLength": 120
                                    }
                                },
                                "additionalProperties": true
                            }
                        }
                    },
                    "additionalProperties": true
                }
            },
            "additionalProperties": true
        },
        "safety": {
            "type": "object"
        },
        "output_rules": {
            "type": "object",
            "required": ["tone", "on_session_end"],
            "properties": {
                "tone": {
                    "type": "string"
                },
                "language": {
                    "type": "string"
                },
                "ask_one_at_a_time": {
                    "type": "boolean"
                },
                "on_session_end": {
                    "type": "string"
                },
                "format": {
                    "type": "string"
                },
                "never_omit_fields": {
                    "type": "boolean"
                },
                "no_explanation": {
                    "type": "boolean"
                }
            },
            "additionalProperties": true
        },
        "examples": {
            "type": "object"
        }
    },
    "additionalProperties": true
}
